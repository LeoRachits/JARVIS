# --- Obrigatório ---
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# --- Personalidade ---
JARVIS_NAME=Jarvis
USER_NAME=Senhor

# --- Modelo (claude-sonnet-4-6 = equilibrado; claude-haiku-4-5 = mais barato/rápido) ---
JARVIS_MODEL=claude-sonnet-4-6
JARVIS_MAX_TOKENS=1500

# --- Busca na web ---
WEB_SEARCH_MAX_USES=5
ENABLE_WEB_SEARCH=true

# --- Robustez da API ---
JARVIS_REQUEST_TIMEOUT=60
JARVIS_MAX_RETRIES=2

# --- Logs ---
JARVIS_LOG_LEVEL=INFO
# Opcional: caminho de um arquivo de log (com rotação). Vazio = só no console.
JARVIS_LOG_FILE=

# --- Memória ---
JARVIS_DB_PATH=jarvis_memory.db

# --- Servidor HTTP ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787
# Token para proteger o servidor (gere um aleatório). Vazio = sem proteção (só local).
JARVIS_API_TOKEN=

# --- Telegram (celular) ---
TELEGRAM_TOKEN=
# Seu id de usuário no Telegram (pegue com @userinfobot). 0 = qualquer um pode usar.
TELEGRAM_ALLOWED_USER_ID=

# --- Tuya Smart IR (ar-condicionado e TV) ---
# Credenciais da Tuya IoT Platform (https://iot.tuya.com → Cloud → Access):
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Região do data center: us | eu | cn | in
TUYA_REGION=us
#
# Por cômodo (repita o bloco para quantos cômodos quiser, ex.: QUARTO, SALA):
#   TUYA_HUB_<COMODO>=<device_id do Smart IR Hub do cômodo>
#   TUYA_AC_<COMODO>=<remote_id do ar-condicionado dentro do hub>
#   TUYA_TV_<COMODO>=<remote_id da TV dentro do hub>
#
TUYA_HUB_QUARTO=
TUYA_AC_QUARTO=
TUYA_TV_QUARTO=
TUYA_HUB_SALA=
TUYA_AC_SALA=
TUYA_TV_SALA=
#
# Índice da biblioteca IR da TV (obtido via tuya_ir_discover.py):
TUYA_TV_REMOTE_INDEX=1192
