# --- Obrigatório ---
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# --- Personalidade ---
JARVIS_NAME=Jarvis
USER_NAME=Senhor

# --- Modelo (claude-sonnet-4-6 = equilibrado; claude-haiku-4-5 = mais barato/rápido) ---
JARVIS_MODEL=claude-sonnet-4-6
JARVIS_MAX_TOKENS=1500

# --- Busca na web ---
WEB_SEARCH_MAX_USES=5
ENABLE_WEB_SEARCH=true

# --- Robustez da API ---
JARVIS_REQUEST_TIMEOUT=60
JARVIS_MAX_RETRIES=2

# --- Logs ---
JARVIS_LOG_LEVEL=INFO
# Opcional: caminho de um arquivo de log (com rotação). Vazio = só no console.
JARVIS_LOG_FILE=

# --- Memória ---
JARVIS_DB_PATH=jarvis_memory.db

# --- Servidor HTTP ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787
# Token para proteger o servidor (gere um aleatório). Vazio = sem proteção (só local).
JARVIS_API_TOKEN=

# --- Telegram (celular) ---
TELEGRAM_TOKEN=
# Seu id de usuário no Telegram (pegue com @userinfobot). 0 = qualquer um pode usar.
TELEGRAM_ALLOWED_USER_ID=
