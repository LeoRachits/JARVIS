# --- Provedores (chaves) ---
# Claude (Anthropic): usado quando você troca o modelo e pela busca na web.
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
# DeepSeek: pegue em platform.deepseek.com (5 milhões de tokens grátis no início).
# Vazio = DeepSeek desligado (cai tudo no Claude).
DEEPSEEK_API_KEY=
# Endpoint compatível com Anthropic do DeepSeek (não precisa mudar).
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# --- Personalidade ---
JARVIS_NAME=Jarvis
USER_NAME=Senhor

# --- Modelos ---
# PADRÃO = DeepSeek (barato). Diga "usa o Claude" por voz para trocar na hora.
JARVIS_MODEL=deepseek-v4-flash
# Modelo "premium" usado quando você pede para trocar.
JARVIS_CLAUDE_MODEL=claude-sonnet-4-6
# Modelo barato que executa a busca na web emprestada (quando está no DeepSeek).
JARVIS_SEARCH_MODEL=claude-haiku-4-5
JARVIS_MAX_TOKENS=1500

# --- Busca na web ---
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=5

# --- Memória ---
JARVIS_DB_PATH=jarvis_memory.db

# --- Servidor HTTP ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787
# Token para proteger o servidor (gere um aleatório). Vazio = sem proteção (só local).
JARVIS_API_TOKEN=

# --- Telegram (celular) ---
TELEGRAM_TOKEN=
# Seu id de usuário no Telegram (pegue com @userinfobot). 0 = qualquer um pode usar.
TELEGRAM_ALLOWED_USER_ID=0

# --- Robustez (rodar 24h) ---
JARVIS_REQUEST_TIMEOUT=60
JARVIS_MAX_RETRIES=3
JARVIS_TOOL_LOOP_LIMIT=6
