# URL do servidor do cérebro (jarvis/server.py)
BRAIN_URL=http://127.0.0.1:8787

# Token de autenticação (deixe vazio se JARVIS_API_TOKEN não estiver configurado)
BRAIN_TOKEN=

# Caminho do modelo Vosk PT-BR (relativo a jarvis-desktop/)
# Download: https://alphacephei.com/vosk/models — vosk-model-small-pt-0.3
WAKE_MODEL_PATH=models/vosk-model-small-pt-0.3

# Segundos de espera por início de fala no follow-up (após resposta)
FOLLOWUP_WINDOW_SEC=8

# Índice do dispositivo de áudio (deixe vazio para usar o padrão do sistema)
# Liste os dispositivos com: python -c "import sounddevice; print(sounddevice.query_devices())"
AUDIO_DEVICE=

# Taxa de amostragem (não altere sem necessidade)
SAMPLE_RATE=16000

# Porta do WebSocket para o HUD
HUD_PORT=8765

# --- Wake word ---

# WAKE_DEBUG=true  → loga em INFO tudo que o Vosk reconhece enquanto em modo wake.
# Use para descobrir quais homófonos o modelo produz ao ouvir "Jarvis" na sua máquina,
# e adicione-os em WAKE_WORDS se necessário.
WAKE_DEBUG=false

# WAKE_WORDS → lista separada por vírgula das palavras/frases de ativação (com ou sem
# acento; a detecção normaliza automaticamente). Se vazio, usa os defaults:
#   jarvis, chaves, já vez, já vês, já pense, aves, de aves
# "chaves" e "aves" são palavras comuns — remova-as aqui se causar falso-positivo.
# Exemplo: WAKE_WORDS=chaves,já vez,já pense
WAKE_WORDS=
