# URL do servidor do cérebro (jarvis/server.py)
BRAIN_URL=http://127.0.0.1:8787

# Token de autenticação (deixe vazio se JARVIS_API_TOKEN não estiver configurado)
BRAIN_TOKEN=

# Sensibilidade da detecção de palma (8.0 = padrão; aumente se disparar fácil demais)
CLAP_SENSITIVITY=8.0

# Índice do dispositivo de áudio (deixe vazio para usar o padrão do sistema)
# Liste os dispositivos com: python -c "import sounddevice; print(sounddevice.query_devices())"
AUDIO_DEVICE=

# Taxa de amostragem (não altere sem necessidade)
SAMPLE_RATE=16000

# Porta do WebSocket para o HUD (SPEC-03)
HUD_WS_PORT=8765
