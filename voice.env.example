# ===========================================================================
#  CAMADA DE VOZ — anexe estas linhas ao seu .env (o mesmo do cérebro, se for
#  a mesma máquina; ou um .env próprio no PC com microfone).
# ===========================================================================

# --- Onde o cérebro está ---
# Mesma máquina: localhost. Cérebro no Pi/Oracle: http://IP_DO_CEREBRO:8787
JARVIS_BRAIN_URL=http://localhost:8787
# Use o MESMO token configurado no servidor do cérebro (JARVIS_API_TOKEN).
# JARVIS_API_TOKEN=

# Memória compartilhada com os outros 'corpos'? Use o mesmo session_id em todos.
VOICE_SESSION_ID=default
VOICE_BRAIN_TIMEOUT=60
VOICE_BRAIN_MAX_RETRIES=3

# --- Microfone (deixe vazio para o padrão do sistema) ---
# Liste dispositivos com:  python -c "import sounddevice as sd; print(sd.query_devices())"
VOICE_MIC_DEVICE=

# --- Palavra de ativação ---
WAKEWORD_MODEL=hey_jarvis
# 0.0–1.0. Mais alto = menos disparos falsos, porém exige fala mais clara.
WAKEWORD_THRESHOLD=0.5

# --- Fala -> texto (Whisper) ---
# tiny | base | small | medium | large-v3  (small é bom equilíbrio em CPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt

# --- Fim de fala (VAD) ---
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=800
VAD_MAX_RECORD_SECONDS=15
VAD_START_TIMEOUT_SECONDS=6

# --- Texto -> fala ---
# piper (local/grátis) | elevenlabs (premium/nuvem)
TTS_ENGINE=piper

# Piper: caminho do modelo .onnx baixado (veja README-voice.md).
PIPER_BINARY=piper
PIPER_MODEL=./voices/pt_BR-faber-medium.onnx

# ElevenLabs (só se TTS_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- UX / operação ---
VOICE_PLAY_BEEP=true
VOICE_OFFLINE_MESSAGE=Não consegui falar com o cérebro agora. Verifique se o servidor está ligado.
VOICE_LOG_LEVEL=INFO
